{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": []
  },
  "description": "Axiom Sentinel Security Operations Centre \u2014 real-time network threat monitoring",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 5,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Threats Per Hour by Type",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "stacking": "normal"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum by (type) (increase(sentinel_threats_detected_total[1h]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Blocked IPs Over Time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "options": {
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sentinel_blocked_ips_active",
          "legendFormat": "Blocked IPs",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#C0392B",
            "mode": "fixed"
          },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Device Trust Score Distribution",
      "type": "histogram",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "options": {
        "bucketSize": "auto",
        "fillOpacity": 80
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sentinel_device_trust_score",
          "legendFormat": "Trust Score",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#004953",
            "mode": "fixed"
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Federated Anomaly Rate Per Round",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "rate(sentinel_federated_anomalies_total[5m])",
          "legendFormat": "Federated Anomalies/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#f59e0b",
            "mode": "fixed"
          },
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Correlation Events Per Hour by Type",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum by (correlation_type) (increase(sentinel_correlations_total[1h]))",
          "legendFormat": "{{correlation_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Top 10 Most-Threatened Devices",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "options": {
        "sortBy": [
          {
            "desc": true,
            "displayName": "Threats"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "topk(10, sum by (device_ip) (sentinel_threats_detected_total))",
          "legendFormat": "{{device_ip}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Threats"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "title": "Geo-IP Threat Origin World Map",
      "type": "geomap",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "options": {
        "view": {
          "id": "zero",
          "lat": 0,
          "lon": 0,
          "zoom": 1
        },
        "layers": [
          {
            "type": "markers",
            "name": "Threat Origins",
            "config": {
              "style": {
                "color": {
                  "fixed": "#C0392B"
                },
                "size": {
                  "field": "Value",
                  "min": 3,
                  "max": 15
                },
                "opacity": 0.8
              }
            }
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum by (country, lat, lon) (sentinel_geo_threats_total)",
          "legendFormat": "{{country}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 8,
      "title": "ZK Network Proof Generation Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "rate(zk_proofs_generated_total{proof_type='NETWORK_INTEGRITY'}[5m])",
          "legendFormat": "Network Integrity Proofs/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "rate(zk_proofs_generated_total{proof_type='FEDERATED_TRAFFIC'}[5m])",
          "legendFormat": "Federated Traffic Proofs/s",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "rate(zk_proofs_generated_total{proof_type='DEVICE_TRUST'}[5m])",
          "legendFormat": "Device Trust Proofs/s",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": [
    "sentinel",
    "security",
    "axiom"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Sentinel Security Operations",
  "uid": "sentinel-soc-v1",
  "version": 1
}