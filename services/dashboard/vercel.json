{
  "version": 2,
  "rewrites": [
    { "source": "/sentinel/(.*)", "destination": "/sentinel/$1" },
    { "source": "/sentinel", "destination": "/sentinel/index.html" }
  ],
  "headers": [
    {
      "source": "/sentinel/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
